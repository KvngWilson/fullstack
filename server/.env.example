# =============================================================================
# FULLSTACK E-COMMERCE APPLICATION - ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit this file with real credentials to version control
# 2. Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Use different secrets for development, staging, and production
# 4. Rotate secrets regularly in production environments
# 5. Use environment-specific .env files: .env.development, .env.production, .env.test
#
# =============================================================================

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
# Options: development, test, production
# This affects error handling, logging verbosity, and security settings
NODE_ENV=development

# Application name (used in logs and database connections)
APP_NAME=fullstack-ecommerce

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port the server will listen on
PORT=5000

# Base API URL (used for HATEOAS links)
# Development: http://localhost:5000
# Production: https://api.yourdomain.com
API_BASE_URL=http://localhost:5000

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres

# Database Connection Pool Settings
# Recommended: max=20-100 for production, min=2-10
DB_POOL_MAX=100
DB_POOL_MIN=10

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret - CRITICAL: Must be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING_MINIMUM_32_CHARS
JWT_EXPIRES_IN=24h

# Session Secret - CRITICAL: Must be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING_MINIMUM_32_CHARS

# =============================================================================
# CSRF (Cross-Site Request Forgery) PROTECTION
# =============================================================================
# CSRF tokens are stored in Redis and validated per session
# Tokens expire after 24 hours to match session TTL

# If enabled, tokens become single-use (deleted after validation)
# Recommended: false (allows token reuse within session TTL)
# Set to 'true' for stricter security (requires frontend to fetch new token per request)
CSRF_SINGLE_USE=false

# =============================================================================
# REDIS CONFIGURATION (Caching & Session Store)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# REDIS_PASSWORD is REQUIRED in production
# Leave empty or comment out for local development without password
REDIS_PASSWORD=

# =============================================================================
# CORS & FRONTEND CONFIGURATION
# =============================================================================
# Frontend application URL(s) - comma-separated for multiple origins
# Development: http://localhost:5173
# Production: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=http://localhost:5173

# For multiple allowed origins (production):
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# SMTP Server Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Email Service (optional - e.g., gmail, outlook, sendgrid)
EMAIL_SERVICE=gmail

# Email Authentication
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Sender Address (shown in "From" field)
EMAIL_FROM=E-Commerce Team <noreply@yourdomain.com>

# Gmail App Password Instructions:
# 1. Enable 2-factor authentication on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail"
# 4. Use that 16-character password as EMAIL_PASS

# =============================================================================
# PAYMENT PROCESSORS
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
# Test Mode Keys (for development)
STRIPE_SECRET_KEY=sk_test_51abc...xyz
STRIPE_PUBLISHABLE_KEY=pk_test_51abc...xyz

# Stripe Webhook Secret (for webhook signature verification)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_abc123...xyz

# Production: Use live keys (sk_live_..., pk_live_...)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_live_...

# -----------------------------------------------------------------------------
# Paystack Configuration
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.paystack.com/#/settings/developer
# Test Mode Keys (for development)
PAYSTACK_SECRET_KEY=sk_test_abc123xyz
PAYSTACK_PUBLIC_KEY=pk_test_abc123xyz

# Production: Use live keys
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...

# =============================================================================
# SHIPPING & LOGISTICS
# =============================================================================
# Easyship API Configuration
# Get your API key from: https://app.easyship.com/settings/api
EASYSHIP_API_KEY=your_easyship_api_key_here

# Default vendor used by shipping rate adapter when vendorId is not provided
DEFAULT_VENDOR_ID=1

# =============================================================================
# TAX CONFIGURATION (ORDERING)
# =============================================================================
# Fallback tax rate when no country/state override is configured
DEFAULT_TAX_RATE=0.08

# Optional JSON map for country-level overrides (2-letter country code keys)
# Example: {"US":0.08,"CA":0.05,"DE":0.19}
TAX_RATE_BY_COUNTRY_JSON=

# Optional JSON map for US state-level overrides (state code keys)
# Applied before country-level overrides for US destinations
# Example: {"CA":0.0825,"NY":0.08875}
TAX_RATE_BY_US_STATE_JSON=

# =============================================================================
# OPERATIONAL ALERTS & MONITORING
# =============================================================================

# Enable/disable operational alerts (default: true in production)
ALERT_ENABLED=true

# Slack Integration
# Create webhook at: https://api.slack.com/messaging/webhooks
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# PagerDuty Integration (for critical alerts only)
# Get keys from: https://support.pagerduty.com/docs/services-and-integrations
PAGERDUTY_API_KEY=
PAGERDUTY_ROUTING_KEY=

# Email alerts for critical issues
# Sent to operations team for manual intervention
OPS_ALERT_EMAIL=ops@yourdomain.com

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log Level Options: error, warn, info, http, verbose, debug, silly
# Production: error or warn
# Development: info or debug
LOG_LEVEL=info

# =============================================================================
# TESTING ENVIRONMENT
# =============================================================================
# These are automatically set when running tests
# No need to modify unless you have a separate test database

# Test Database (used when NODE_ENV=test)
# DB_NAME=ecommerce_test
# DB_USER=postgres
# DB_PASSWORD=postgres

# =============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# =============================================================================

# AWS S3 Configuration (for file uploads)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Cloudinary Configuration (alternative for image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Sentry Configuration (error tracking)
# SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/123456

# Google Analytics
# GA_TRACKING_ID=UA-123456789-1

# =============================================================================
# DEVELOPMENT QUICK START
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Generate SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Update database credentials (DB_USER, DB_PASSWORD)
# 5. Configure email settings for your SMTP provider
# 6. For payments: Add test keys from Stripe/Paystack dashboards
# 7. Run: npm install && npm run migrate && npm run dev
#
# =============================================================================

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# NODE_ENV=production
# Strong JWT_SECRET (64+ chars) and SESSION_SECRET (64+ chars)
# REDIS_PASSWORD is set
# DB_HOST is not localhost
# EMAIL_* settings configured with production SMTP
# STRIPE_SECRET_KEY uses live keys (sk_live_...)
# FRONTEND_URL points to production domain
# ALLOWED_ORIGINS includes all production domains
# LOG_LEVEL set to 'error' or 'warn'
# Database backups configured
# SSL/TLS certificates installed
#
# =============================================================================
