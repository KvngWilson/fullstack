<section class="split-grid">
  <div class="space-y-6">
    <div class="card">
      <div class="card-header">
        <div>
          <p class="section-kicker">Add New Product</p>
          <h3 class="card-title">Basic Details</h3>
        </div>
        <button class="btn btn-outline btn-compact" type="button">Save draft</button>
      </div>
      <div class="card-body">
        <div class="form-group">
          <label class="form-label">Product Name</label>
          <input class="form-input" placeholder="e.g. Apple iPhone 15" />
        </div>
        <div class="form-group">
          <label class="form-label">Product Description</label>
          <textarea class="form-input" rows="5" placeholder="Describe the product..."></textarea>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group">
            <label class="form-label">Product Price</label>
            <input class="form-input" placeholder="$0.00" />
          </div>
          <div class="form-group">
            <label class="form-label">Sale Price</label>
            <input class="form-input" placeholder="$0.00" />
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group">
            <label class="form-label">SKU</label>
            <input class="form-input" placeholder="SKU-0001" />
          </div>
          <div class="form-group">
            <label class="form-label">Stock</label>
            <input class="form-input" placeholder="120" />
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <p class="section-kicker">Inventory</p>
          <h3 class="card-title">Availability</h3>
        </div>
      </div>
      <div class="card-body grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="form-group">
          <label class="form-label">Status</label>
          <select class="form-select">
            <option>In Stock</option>
            <option>Out of Stock</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Visibility</label>
          <select class="form-select">
            <option>Visible</option>
            <option>Hidden</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="card">
      <div class="card-header">
        <div>
          <p class="section-kicker">Media</p>
          <h3 class="card-title">Upload Product Image</h3>
        </div>
      </div>
      <div class="card-body">
        <div class="upload-box">
          <div class="upload-preview"></div>
          <div>
            <p class="text-sm font-semibold text-slate-900">Drag and drop files</p>
            <p class="text-xs text-slate-500">PNG, JPG up to 5MB</p>
          </div>
          <button class="btn btn-outline btn-compact" type="button">Browse</button>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <p class="section-kicker">Categories</p>
          <h3 class="card-title">Product Category</h3>
        </div>
      </div>
      <div class="card-body">
        <div class="form-group">
          <label class="form-label">Select Category</label>
          <select class="form-select">
            <% categories.forEach((category) => { %>
              <option><%= category.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <input class="form-input" placeholder="Smartphone, iOS, 5G" />
        </div>
        <div class="form-group">
          <label class="form-label">Colors</label>
          <div class="color-row">
            <span class="color-swatch bg-slate-900"></span>
            <span class="color-swatch bg-emerald-500"></span>
            <span class="color-swatch bg-amber-500"></span>
            <span class="color-swatch bg-sky-500"></span>
            <span class="color-swatch bg-rose-500"></span>
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-outline" type="button">Save draft</button>
          <button class="btn btn-primary" type="button">Publish product</button>
        </div>
      </div>
    </div>
  </div>
</section>