<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/output.css" />
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body class="page-shell">
  <div class="app-shell">
    <%- include('../partials/sidebar', { user, navItems, secondaryNav, currentRoute }) %>

    <main class="main-content">
      <%- include('../partials/topbar', { pageTitle, user }) %>
      <div class="content-wrap">
        <%- body %>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>

</html>