<% if (pagination) { %>
  <div class="pagination">
    <p class="pagination-info">
      Page <%= pagination.page %> of <%= pagination.totalPages %> • <%= pagination.total %> <%= label || 'items' %>
    </p>
    <div class="pagination-actions">
      <a class="pagination-item <%= pagination.hasPrevious ? '' : 'pagination-item-disabled' %>" href="<%= pagination.hasPrevious ? prevHref : '#' %>">Previous</a>
      <a class="pagination-item <%= pagination.hasNext ? '' : 'pagination-item-disabled' %>" href="<%= pagination.hasNext ? nextHref : '#' %>">Next</a>
    </div>
  </div>
<% } %>
