<a href="<%= item.href %>"
   class="nav-link <%= currentRoute === item.href ? 'nav-link-active' : 'nav-link-inactive' %> <%= item.variant || '' %>">
   <span class="nav-icon"><%- item.icon %></span>
   <span class="nav-label"><%= item.label %></span>
   <% if (item.badge) { %>
     <span class="nav-badge"><%= item.badge %></span>
   <% } %>
</a>