<div class="bg-white rounded-lg shadow p-6 flex flex-col gap-4">
  <div class="flex items-center justify-between">
    <div class="min-w-0 flex-1 pr-4">
      <p class="text-sm text-gray-500"><%= title %></p>
      <h3 class="text-2xl font-bold text-gray-900 break-words"><%= value %></h3>
    </div>
    <% if (typeof icon !== 'undefined' && icon) { %>
      <div class="flex shrink-0 items-center justify-center w-10 h-10 bg-blue-100 rounded-full"><%- icon %></div>
    <% } %>
  </div>

  <div class="flex items-center gap-2 mt-2">
    <span class="inline-block <%= trend >= 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %> text-xs font-semibold px-2 py-1 rounded">
      <%= trend > 0 ? '+' : '' %><%= trend %>%
    </span>
    <span class="text-xs text-gray-500"><%= (typeof subtitle !== 'undefined' && subtitle) ? subtitle : 'vs last month' %></span>
  </div>
</div>