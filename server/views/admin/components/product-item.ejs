<div class="flex items-center gap-3">
  <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center overflow-hidden">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover" />
    <% } else { %>
      <span class="text-base font-semibold text-blue-700"><%= product.initials || 'PR' %></span>
    <% } %>
  </div>

  <div class="flex-1 min-w-0">
    <p class="text-sm font-semibold truncate"><%= product.name %></p>
    <p class="text-xs text-slate-500">$<%= product.price %></p>
  </div>

  <span class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded">+$<%= product.revenue %></span>
</div>