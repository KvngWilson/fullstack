<div class="flex items-center gap-3">
  <div class="w-12 h-12 bg-primary-brand/10 rounded-lg flex items-center justify-center overflow-hidden">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover" />
    <% } else { %>
      <span class="text-base font-semibold text-primary-brand"><%= product.initials || 'PR' %></span>
    <% } %>
  </div>

  <div class="flex-1 min-w-0">
    <p class="text-sm font-semibold truncate"><%= product.name %></p>
    <p class="text-xs text-slate-500">$<%= product.price %></p>
  </div>

  <span class="badge badge-success">+$<%= product.revenue %></span>
</div>