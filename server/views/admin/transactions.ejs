<% layout('admin/layouts/main') %>

<section class="metric-grid mb-8">
  <% summary.cards.forEach((card) => { %>
    <div class="card metric-card">
      <div>
        <p class="metric-title"><%= card.label %></p>
        <h3 class="metric-value"><%= card.value %></h3>
        <p class="metric-subtitle"><%= card.sub %></p>
      </div>
      <div class="metric-icon"><%- card.icon %></div>
    </div>
  <% }) %>
</section>

<section class="card mb-8">
  <div class="card-header">
    <div>
      <p class="section-kicker">Payments</p>
      <h3 class="card-title">Payment Methods</h3>
    </div>
    <span class="chip">Last 30 days</span>
  </div>
  <div class="payment-card">
    <div>
      <p class="text-xs uppercase tracking-widest text-white-muted">Balance</p>
      <h3 class="text-2xl font-semibold text-white-strong"><%= summary.balance %></h3>
    </div>
    <div class="payment-meta">
      <div>
        <p class="text-xs text-white-muted">Card Holder</p>
        <p class="text-sm text-white-strong">Admin Team</p>
      </div>
      <div>
        <p class="text-xs text-white-muted">Expires</p>
        <p class="text-sm text-white-strong">12/29</p>
      </div>
    </div>
  </div>
</section>

<section class="card">
  <div class="card-header">
    <div>
      <p class="section-kicker">History</p>
      <h3 class="card-title">Transactions</h3>
    </div>
  </div>

  <div class="table-container">
    <table class="table">
      <thead class="table-header">
        <tr>
          <th class="table-header-cell">Customer</th>
          <th class="table-header-cell">Date</th>
          <th class="table-header-cell">Method</th>
          <th class="table-header-cell">Amount</th>
          <th class="table-header-cell">Status</th>
          <th class="table-header-cell">Action</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach((tx) => { %>
          <tr class="table-row">
            <td class="table-cell">
              <div class="flex items-center gap-3">
                <img src="<%= tx.avatar %>" class="avatar avatar-sm" alt="Customer">
                <div>
                  <p class="text-sm font-semibold text-slate-900"><%= tx.customer %></p>
                  <p class="text-xs text-slate-500"><%= tx.reference %></p>
                </div>
              </div>
            </td>
            <td class="table-cell text-slate-500"><%= tx.date %></td>
            <td class="table-cell"><span class="chip"><%= tx.method %></span></td>
            <td class="table-cell font-semibold">$<%= tx.amount %></td>
            <td class="table-cell"><span class="badge badge-<%= tx.status %>"><%= tx.statusLabel %></span></td>
            <td class="table-cell"><button class="btn btn-ghost btn-compact" type="button">View</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card-footer">
    <%- include('components/pagination', { pagination, label, prevHref, nextHref }) %>
  </div>
</section>