<section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
  <!-- Card 1: Total Customers -->
  <div class="bg-white rounded-lg shadow p-6 flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Total Customers</p>
        <h3 class="text-2xl font-bold text-gray-900"><%= userSummary.total %></h3>
      </div>
      <div class="flex items-center justify-center w-10 h-10 bg-blue-100 rounded-full">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
      </div>
    </div>
    <div class="flex items-center gap-2 mt-2">
      <span class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded">+<%= userSummary.newLast30 %>%</span>
      <span class="text-xs text-gray-500">New this month</span>
    </div>
  </div>

  <!-- Card 2: Active Customers -->
  <div class="bg-white rounded-lg shadow p-6 flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Active Customers</p>
        <h3 class="text-2xl font-bold text-gray-900"><%= userSummary.active %></h3>
      </div>
      <div class="flex items-center justify-center w-10 h-10 bg-indigo-100 rounded-full">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
      </div>
    </div>
    <div class="flex items-center gap-2 mt-2">
      <span class="inline-block bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-1 rounded">Active now</span>
      <span class="text-xs text-gray-500">Last 7 days</span>
    </div>
  </div>

  <!-- Card 3: Admins -->
  <div class="bg-white rounded-lg shadow p-6 flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Admins</p>
        <h3 class="text-2xl font-bold text-gray-900"><%= userSummary.admins %></h3>
      </div>
      <div class="flex items-center justify-center w-10 h-10 bg-purple-100 rounded-full">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2l7 4v6c0 5-3 9-7 10-4-1-7-5-7-10V6l7-4z" />
        </svg>
      </div>
    </div>
    <div class="flex items-center gap-2 mt-2">
      <span class="inline-block bg-gray-200 text-gray-800 text-xs font-semibold px-2 py-1 rounded">Secure</span>
      <span class="text-xs text-gray-500">Access control</span>
    </div>
  </div>
</section>

<section class="bg-white rounded-lg shadow p-6 mt-8">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
    <div>
      <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Team</p>
      <h3 class="text-lg font-bold text-gray-900">Customers</h3>
    </div>
    <div class="flex items-center gap-2">
      <div class="relative flex items-center">
        <span class="absolute left-3 text-gray-400">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input type="text" placeholder="Search customers" class="pl-9 pr-3 py-2 rounded border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-64" />
      </div>
    </div>
  </div>

  <div class="overflow-x-auto">
    <% if (users && users.length > 0) { %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Customer</th>
            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</th>
            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Created</th>
            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Last Login</th>
            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% users.forEach((entry) => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(entry.email) %>" class="w-8 h-8 rounded-full border border-gray-200" alt="Customer">
                  <div>
                    <p class="text-sm font-semibold text-slate-900"><%= entry.email %></p>
                    <p class="text-xs text-slate-500">#<%= entry.id %></p>
                  </div>
                </div>
              </td>
              <td class="table-cell">
                <form method="POST" action="/users/<%= entry.id %>/role" class="flex items-center gap-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="returnTo" value="<%= currentUrl %>">
                  <select name="role" class="form-select">
                    <option value="customer" <%= entry.role === 'customer' ? 'selected' : '' %>>Customer</option>
                    <option value="vendor" <%= entry.role === 'vendor' ? 'selected' : '' %>>Vendor</option>
                    <option value="admin" <%= entry.role === 'admin' ? 'selected' : '' %>>Admin</option>
                  </select>
                  <button type="submit" class="btn btn-outline btn-compact">Save</button>
                </form>
              </td>
              <td class="table-cell text-slate-600"><%= entry.created_at ? new Date(entry.created_at).toLocaleDateString() : '-' %></td>
              <td class="table-cell text-slate-600"><%= entry.last_login ? new Date(entry.last_login).toLocaleDateString() : 'Never' %></td>
              <td class="table-cell">
                <form method="POST" action="/users/<%= entry.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline-flex">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="returnTo" value="<%= currentUrl %>">
                  <button type="submit" class="btn btn-ghost btn-compact">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">No users found.</div>
    <% } %>
  </div>

  <div class="card-footer">
    <%- include('components/pagination', { pagination, label, prevHref, nextHref }) %>
  </div>
</section>