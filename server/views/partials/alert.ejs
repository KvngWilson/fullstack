<!-- Alert Messages Partial -->
<% if (error_msg) { %>
  <div class="mb-4 rounded-md bg-red-100 border border-red-300 text-red-800 px-4 py-3 text-sm font-medium">
    <%= error_msg %>
  </div>
<% } %>

<% if (success_msg) { %>
  <div class="mb-4 rounded-md bg-green-100 border border-green-300 text-green-800 px-4 py-3 text-sm font-medium">
    <%= success_msg %>
  </div>
<% } %>
