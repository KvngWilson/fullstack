<%- include('../partials/header', { title: title, user: user, cartCount: cartCount }) %>

<section class="min-h-screen flex items-center justify-center bg-gray-50 py-8">
  <div class="w-full max-w-4xl flex flex-col md:flex-row gap-8 bg-white shadow-lg rounded-lg p-8">
    <aside class="w-full md:w-1/2 flex flex-col gap-4 border-r border-gray-200 pr-8">
      <span class="inline-block bg-red-100 text-red-800 text-xs font-semibold px-3 py-1 rounded-full">Restricted Access</span>
      <h1 class="text-2xl font-bold text-gray-900">Admin Control Center</h1>
      <p class="text-gray-600 text-sm">
        Sign in with your administrator account to manage users, orders, products, and site operations.
      </p>
      <ul class="list-disc list-inside text-gray-500 text-sm space-y-1">
        <li>Only authorized admin and operations staff are allowed.</li>
        <li>All access attempts are monitored and rate-limited.</li>
        <li>Use your assigned work account credentials.</li>
      </ul>
    </aside>

    <div class="w-full md:w-1/2 flex flex-col gap-6">
      <h2 class="text-xl font-semibold text-gray-800">Administrator Sign In</h2>
      <p class="text-gray-500 text-sm">Enter your admin credentials to continue.</p>

      <%- include('../partials/alert', { error_msg, success_msg }) %>

      <form method="POST" action="<%= formAction || '/auth/login' %>" novalidate class="flex flex-col gap-4">
        <input type="hidden" name="returnTo" value="<%= form?.returnTo || '/dashboard' %>">

        <div class="flex flex-col gap-1">
          <label for="email" class="block text-sm font-medium text-gray-700">Admin Email</label>
          <input
            id="email"
            name="email"
            type="email"
            class="block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
            value="<%= form?.email || '' %>"
            required
            autocomplete="email"
            placeholder="admin@company.com"
          >
        </div>

        <div class="flex flex-col gap-1">
          <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            class="block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
            required
            autocomplete="current-password"
            placeholder="Enter your password"
          >
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md shadow focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition">Sign In to Admin Panel</button>
      </form>

      <p class="text-xs text-gray-500 mt-2">
        Not an admin? Return to <a class="text-blue-600 hover:underline" href="/">the storefront</a>.
      </p>
    </div>
  </div>
  </div>
</section>

<%- include('../partials/footer') %>
