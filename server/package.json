{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit --config=jest.config.prod.js --coverage",
    "test:integration": "jest tests/integration --config=jest.config.prod.js --coverage",
    "test:e2e": "jest tests/e2e --config=jest.config.prod.js --coverage",
    "test:security": "jest tests/security --config=jest.config.prod.js --coverage",
    "test:all": "jest tests/unit tests/integration tests/e2e tests/security --config=jest.config.prod.js --coverage",
    "test:coverage": "jest tests/unit tests/integration tests/e2e tests/security --config=jest.config.prod.js --coverage --collectCoverageFrom='src/**/*.js' --collectCoverageFrom='!src/**/*.test.js' --collectCoverageFrom='!src/**/index.js'",
    "test:debug": "DEBUG_TESTS=true jest --config=jest.config.prod.js --no-coverage",
    "test:watch": "jest tests/unit --config=jest.config.prod.js --watch",
    "migrate": "node scripts/migrate.js pending",
    "migrate:initial": "node scripts/migrate.js initial",
    "migrate:rollback": "node scripts/migrate.js rollback"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
