# Test Environment Variables
NODE_ENV=test

# Test Database Configuration
DB_HOST=localhost
DB_PORT=5445
DB_NAME=fullstack_test
DB_USER=postgres
DB_PASSWORD=postgres

# API Configuration
API_PORT=5000
JWT_SECRET=test_jwt_secret_key_for_testing_only

# Email Configuration
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USER=test_user
EMAIL_PASSWORD=test_password

# External Services (Mocked in tests)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_test_mock
REDIS_URL=redis://localhost:6379

# Payment Configuration
PAYMENT_MIN_AMOUNT=100
PAYMENT_MAX_AMOUNT=9999999

# Shipping Configuration  
SHIPPING_RATE_CACHE_TTL=3600
SHIPPING_API_TIMEOUT=5000

# Security
HASH_ROUNDS=10
TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=2592000

# Feature Flags
ENABLE_PAYMENT_WEBHOOKS=true
ENABLE_SHIPPING_INTEGRATION=true
ENABLE_CUSTOMER_ISOLATION=true
