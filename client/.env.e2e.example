# E2E Test Environment Configuration

# Backend API URL (default: http://localhost:3000)
API_URL=http://gateway

# Frontend URL where app is served (default: http://localhost:5173)
BASE_URL=http://client

# E2E execution settings
CI=false
DEBUG=false

# Test user credentials (replace with actual test accounts from backend)
TEST_USER_EMAIL=test.customer@example.com
TEST_USER_PASSWORD=TestPass123!

TEST_ADMIN_EMAIL=test.admin@example.com
TEST_ADMIN_PASSWORD=AdminPass123!

# Timeout settings (milliseconds)
TIMEOUT=30000
