# API Configuration
VITE_API_URL=http://localhost:3000
VITE_API_VERSION=v1

# Payment Gateways
VITE_STRIPE_PUBLIC_KEY=pk_test_...
VITE_PAYPAL_CLIENT_ID=...

# Image Upload
VITE_MAX_FILE_SIZE=5242880 # 5MB
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Features
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_VENDOR_REGISTRATION=true

# Analytics (optional)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=
