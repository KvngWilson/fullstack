{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --analyze",
    "preview:build": "vite build && vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci:coverage": "node ./scripts/check-coverage.mjs",
    "ci:coverage:policy": "COVERAGE_LINES_THRESHOLD=80 COVERAGE_STATEMENTS_THRESHOLD=80 COVERAGE_FUNCTIONS_THRESHOLD=80 COVERAGE_BRANCHES_THRESHOLD=80 CRITICAL_COVERAGE_THRESHOLD=100 CRITICAL_COVERAGE_FILES=src/api/requestCache.js,src/features/auth/authThunks.js node ./scripts/check-coverage.mjs",
    "ci:bundle": "node ./scripts/check-bundle-size.mjs",
    "e2e": "cypress run",
    "e2e:critical": "cypress run --spec e2e/account.cy.js,e2e/rbac.cy.js,e2e/checkout.cy.js,e2e/errors.cy.js,e2e/mobile.cy.js,e2e/payment-callback.cy.js",
    "e2e:open": "cypress open",
    "e2e:headed": "cypress run --headed"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.8.14",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.3",
    "redux": "^5.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.1",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^5.1.3",
    "babel-jest": "^30.2.0",
    "cypress": "^15.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.0",
    "vite": "^6.3.6",
    "vite-plugin-compression": "^0.5.1"
  }
}
