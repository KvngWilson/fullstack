# =============================================================================
# FULLSTACK E-COMMERCE APPLICATION - DOCKER COMPOSE ENVIRONMENT
# =============================================================================
#
# This .env file provides configuration for both frontend and backend services
# when using Docker Compose. Copy this file to .env and customize values.
#
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit .env with real credentials to version control
# 2. Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Use different secrets for development, staging, and production
# 4. Rotate secrets regularly in production environments
#
# =============================================================================

# =============================================================================
# GENERAL APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
APP_NAME=fullstack-ecommerce

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres

# Database Connection Pool Settings
# Recommended: max=20-100 for production, min=2-10
DB_POOL_MAX=100
DB_POOL_MIN=10

# =============================================================================
# REDIS CONFIGURATION (Caching & Session Store)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# REDIS_PASSWORD is REQUIRED in production
# For development with docker-compose, default is used
REDIS_PASSWORD=redis_dev_password_1234567890

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000

# Base URLs
API_BASE_URL=http://localhost:5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# =============================================================================
# CORS & FRONTEND CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret - CRITICAL: Must be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=24h

# Session Secret - CRITICAL: Must be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# For development, docker-compose includes MailHog (http://localhost:8025)
# For production, configure your SMTP provider

EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_SERVICE=mailhog
EMAIL_USER=dev@example.com
EMAIL_PASS=
EMAIL_FROM=E-Commerce Team <noreply@localhost>

# To use Gmail (for development):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password

# To use SendGrid (for production):
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_SERVICE=sendgrid
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your_sendgrid_api_key_here

# =============================================================================
# PAYMENT PROCESSORS
# =============================================================================

# Stripe Configuration
# Get test keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_dev_mode
STRIPE_PUBLISHABLE_KEY=pk_test_dev_mode
STRIPE_WEBHOOK_SECRET=whsec_dev_mode

# For production, use live keys:
# STRIPE_SECRET_KEY=sk_live_your_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_public_key
# STRIPE_WEBHOOK_SECRET=whsec_live_your_webhook_secret

# Paystack Configuration
# Get test keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_dev_mode
PAYSTACK_PUBLIC_KEY=pk_test_dev_mode

# For production, use live keys:
# PAYSTACK_SECRET_KEY=sk_live_your_secret_key
# PAYSTACK_PUBLIC_KEY=pk_live_your_public_key

# =============================================================================
# SHIPPING & LOGISTICS
# =============================================================================
# Easyship API Configuration
# Get your API key from: https://app.easyship.com/settings/api
EASYSHIP_API_KEY=dev_mode_key

# Default vendor used by shipping rate adapter when vendorId is not provided
DEFAULT_VENDOR_ID=1

# =============================================================================
# TAX CONFIGURATION (ORDERING)
# =============================================================================
# Fallback tax rate when no country/state override is configured
DEFAULT_TAX_RATE=0.08

# Optional JSON map for country-level overrides (2-letter country code keys)
# Example: {"US":0.08,"CA":0.05,"DE":0.19}
TAX_RATE_BY_COUNTRY_JSON=

# Optional JSON map for US state-level overrides (state code keys)
# Applied before country-level overrides for US destinations
# Example: {"CA":0.0825,"NY":0.08875}
TAX_RATE_BY_US_STATE_JSON=

# =============================================================================
# FRONTEND (CLIENT) CONFIGURATION - VITE
# =============================================================================

# API Configuration
VITE_API_URL=http://localhost:5000
VITE_API_VERSION=v1

# Payment Gateways (Public Keys)
VITE_STRIPE_PUBLIC_KEY=pk_test_dev_mode
VITE_PAYPAL_CLIENT_ID=

# Image Upload Settings
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Feature Flags
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_VENDOR_REGISTRATION=true

# Analytics & Error Tracking (optional)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# =============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# =============================================================================

# AWS S3 Configuration (for file uploads)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Cloudinary Configuration (alternative for image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Sentry Configuration (error tracking - backend)
# SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/123456

# Google Analytics (backend - if needed)
# GA_TRACKING_ID=UA-123456789-1

# =============================================================================
# DOCKER COMPOSE SPECIFIC
# =============================================================================

# Client port mapping (default: 3000)
CLIENT_PORT=3000

# =============================================================================
# DEVELOPMENT QUICK START
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Generate SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Start services: docker compose -f docker-compose.dev.yml up -d
# 5. Initialize database: docker compose exec server npm run migrate
# 6. Seed database: docker compose exec server npm run seed
# 7. Access application: http://localhost:3000
# 8. View emails: http://localhost:8025 (MailHog)
#
# =============================================================================

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# NODE_ENV=production
# Strong JWT_SECRET (64+ chars) and SESSION_SECRET (64+ chars)
# REDIS_PASSWORD is set to strong value
# DB_HOST is not localhost
# EMAIL_* settings configured with production SMTP
# STRIPE_* and PAYSTACK_* use production keys (not test)
# FRONTEND_URL points to production domain
# ALLOWED_ORIGINS includes all production domains
# LOG_LEVEL set to 'error' or 'warn'
# Database backups configured
# SSL/TLS certificates installed
# Error tracking (Sentry) configured
# Analytics (GA, Mixpanel) configured
# All sensitive values in production secrets manager
#
# =============================================================================
