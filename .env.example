# =============================================================================
# FULLSTACK E-COMMERCE APPLICATION - CONSOLIDATED ENVIRONMENT CONFIGURATION
# =============================================================================
#
# Copy this file to .env and customize values for your environment.
#
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit .env with real credentials to version control
# 2. Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Use different secrets for development, staging, and production
# 4. Rotate secrets regularly in production environments
#
# =============================================================================

# =============================================================================
# GENERAL APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
APP_NAME=fullstack-ecommerce

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
API_BASE_URL=http://localhost:5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
# Host port used by docker-compose for local PostgreSQL access.
# Change this if 55432 is already in use on your machine.
POSTGRES_HOST_PORT=55432
# Host port used by docker-compose for local Redis access.
# Change this if 63799 is already in use on your machine.
REDIS_HOST_PORT=63799
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=100
DB_POOL_MIN=10

# SSL/TLS Configuration (Required for production)
# Set to production database SSL certificate, certificate key, and CA bundle
# Generate self-signed certificate: openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365
# DB_SSL_ENABLED=false             # Set true to force TLS to Postgres
# DB_SSL_CA=/path/to/ca.pem       # Optional CA certificate bundle
# DB_SSL_CERT=/path/to/cert.pem   # Optional client certificate
# DB_SSL_KEY=/path/to/key.pem     # Optional client key

# =============================================================================
# REDIS CONFIGURATION (Caching & Session Store)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_dev_password_1234567890abcdef
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# RBAC permission caching (seconds). Permission sets are cached per employee;
# the user -> employee-id lookup uses a shorter TTL so deactivated staff lose
# access quickly. Mutations invalidate the cache explicitly.
PERMISSION_CACHE_TTL_SECONDS=1800
EMPLOYEE_ID_CACHE_TTL_SECONDS=300

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=24h
SESSION_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# CSRF (Cross-Site Request Forgery) PROTECTION
CSRF_SINGLE_USE=false

# =============================================================================
# CORS & FRONTEND CONFIGURATION
# =============================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000,http://admin.localhost:5000

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_SERVICE=mailhog
EMAIL_USER=dev@example.com
EMAIL_PASS=
EMAIL_FROM=E-Commerce Team <noreply@localhost>
# For Gmail/SendGrid, see commented examples below:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-specific-password
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SERVICE=sendgrid
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your_sendgrid_api_key_here

# =============================================================================
# PAYMENT PROCESSORS
# =============================================================================
# Stripe
STRIPE_SECRET_KEY=sk_test_dev_mode
STRIPE_PUBLISHABLE_KEY=pk_test_dev_mode
STRIPE_WEBHOOK_SECRET=whsec_dev_mode
# Paystack
PAYSTACK_SECRET_KEY=sk_test_dev_mode
PAYSTACK_PUBLIC_KEY=pk_test_dev_mode

# =============================================================================
# SHIPPING & LOGISTICS
# =============================================================================
EASYSHIP_API_KEY=dev_mode_key
DEFAULT_VENDOR_ID=1

# =============================================================================
# TAX CONFIGURATION (ORDERING)
# =============================================================================
DEFAULT_TAX_RATE=0.08
TAX_RATE_BY_COUNTRY_JSON=
TAX_RATE_BY_US_STATE_JSON=

# =============================================================================
# CURRENCY & LOCALIZATION
# =============================================================================
DEFAULT_CURRENCY=USD
BASE_CURRENCY=USD

# =============================================================================
# FRONTEND (CLIENT) CONFIGURATION - VITE
# =============================================================================
VITE_API_URL=http://localhost:5000
VITE_API_VERSION=v1
VITE_STRIPE_PUBLIC_KEY=pk_test_dev_mode
VITE_PAYPAL_CLIENT_ID=
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_VENDOR_REGISTRATION=true
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# =============================================================================
# OPERATIONAL ALERTS & MONITORING
# =============================================================================
ALERT_ENABLED=true
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=
PAGERDUTY_ROUTING_KEY=
OPS_ALERT_EMAIL=ops@yourdomain.com

# =============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# =============================================================================
# AWS S3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# Cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Sentry (backend)
# SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/123456
# Google Analytics (backend)
# GA_TRACKING_ID=UA-123456789-1

# =============================================================================
# DOCKER COMPOSE SPECIFIC
# =============================================================================
CLIENT_PORT=3000

# =============================================================================
# DEVELOPMENT QUICK START
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Generate SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Start services: docker compose -f docker-compose.dev.yml up -d
# 5. Initialize database: docker compose exec server npm run migrate
# 6. Seed database: docker compose exec server npm run seed
# 7. Access application: http://localhost:3000
# 8. View emails: http://localhost:8025 (MailHog)
#
# =============================================================================

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# NODE_ENV=production
# Strong JWT_SECRET (64+ chars) and SESSION_SECRET (64+ chars)
# REDIS_PASSWORD is set to strong value
# DB_HOST is not localhost
# EMAIL_* settings configured with production SMTP
# STRIPE_* and PAYSTACK_* use production keys (not test)
# FRONTEND_URL points to production domain
# ALLOWED_ORIGINS includes all production domains
# LOG_LEVEL set to 'error' or 'warn'
# Database backups configured
# SSL/TLS certificates installed
# Error tracking (Sentry) configured
# Analytics (GA, Mixpanel) configured
# All sensitive values in production secrets manager
#
# =============================================================================